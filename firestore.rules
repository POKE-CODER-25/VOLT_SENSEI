rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if ownsUserDoc(uid);
      allow delete: if false;
    }

    match /chatHistory/{docId} {
      allow read: if signedIn() && request.auth.uid == resource.data.uid;
      allow create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /quizAttempts/{docId} {
      allow read, create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /revisionHistory/{docId} {
      allow read, create: if signedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }
  }
}
